"""
Perceptron Learning Algorithm (PLA)
Corresponding to Problem 1.4 in "Learning From Data"
"""

import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

class Perceptron:
    def __init__(self, dim=2):
        self.w = np.zeros(dim + 1)  # +1 for bias
    
    def predict(self, x):
        """x should include x0=1"""
        return np.sign(np.dot(self.w, x))
    
    def train(self, X, y, max_iter=10000, verbose=True):
        """
        X: (N, dim+1) array with x0=1
        y: (N,) array of ±1
        """
        N = len(y)
        iterations = 0
        
        while iterations < max_iter:
            # Find misclassified points
            misclassified = []
            for i in range(N):
                if self.predict(X[i]) != y[i]:
                    misclassified.append(i)
            
            if not misclassified:
                if verbose:
                    print(f"Converged after {iterations} iterations!")
                break
            
            # Pick first misclassified point (deterministic)
            idx = misclassified[0]
            # Update weights
            self.w += y[idx] * X[idx]
            iterations += 1
        
        if iterations == max_iter and verbose:
            print("Reached max iterations without full convergence.")
        
        return iterations


def generate_linearly_separable_data(N=20, dim=2):
    """Generate random target function and N data points"""
    # Random target function (line through origin, then shift)
    w_target = np.random.randn(dim + 1)
    w_target[0] = np.random.uniform(-1, 1)  # bias
    
    # Generate random points in [-1, 1]^dim
    X_raw = np.random.uniform(-1, 1, (N, dim))
    X = np.hstack([np.ones((N, 1)), X_raw])  # add x0=1
    
    # Generate labels
    y = np.sign(np.dot(X, w_target))
    
    # Handle edge case where some points are exactly on the line
    y[y == 0] = 1
    
    return X, y, w_target


def plot_2d(X, y, w, w_target, title="PLA Result"):
    """Plot 2D data and decision boundary"""
    plt.figure(figsize=(8, 8))
    
    # Plot points
    for i in range(len(y)):
        if y[i] == 1:
            plt.scatter(X[i, 1], X[i, 2], c='red', marker='o', s=50, alpha=0.7)
        else:
            plt.scatter(X[i, 1], X[i, 2], c='blue', marker='x', s=50, alpha=0.7)
    
    # Plot decision boundary (learned)
    x1_range = np.linspace(-1, 1, 100)
    if w[2] != 0:
        x2_learned = -(w[0] + w[1] * x1_range) / w[2]
        plt.plot(x1_range, x2_learned, 'g-', linewidth=2, label='Learned g')
    
    # Plot target function
    if w_target[2] != 0:
        x2_target = -(w_target[0] + w_target[1] * x1_range) / w_target[2]
        plt.plot(x1_range, x2_target, 'k--', linewidth=2, label='Target f')
    
    plt.xlabel('x1', fontsize=14)
    plt.ylabel('x2', fontsize=14)
    plt.title(title, fontsize=14)
    plt.legend(fontsize=12)
    plt.grid(True, alpha=0.3)
    plt.xlim(-1, 1)
    plt.ylim(-1, 1)
    plt.tight_layout()
    plt.savefig('pla_result.png', dpi=150)
    plt.show()


def experiment(N=20, dim=2, num_trials=10):
    """Run multiple experiments and collect statistics"""
    iterations_list = []
    
    for trial in range(num_trials):
        X, y, w_target = generate_linearly_separable_data(N, dim)
        p = Perceptron(dim=dim)
        iters = p.train(X, y, verbose=False)
        iterations_list.append(iters)
        
        if trial == 0:  # Plot first trial
            if dim == 2:
                plot_2d(X, y, p.w, w_target, 
                       f"PLA (N={N}, converged in {iters} iterations)")
    
    print(f"\n=== Experiment Results (N={N}, dim={dim}, {num_trials} trials) ===")
    print(f"Mean iterations: {np.mean(iterations_list):.1f}")
    print(f"Std iterations: {np.std(iterations_list):.1f}")
    print(f"Min iterations: {np.min(iterations_list)}")
    print(f"Max iterations: {np.max(iterations_list)}")


if __name__ == "__main__":
    print("=" * 60)
    print("Perceptron Learning Algorithm Demo")
    print("=" * 60)
    
    # Single run with visualization
    print("\n--- Single Run (N=20, dim=2) ---")
    X, y, w_target = generate_linearly_separable_data(N=20, dim=2)
    p = Perceptron(dim=2)
    iters = p.train(X, y)
    print(f"Final weights: {p.w}")
    print(f"Target weights: {w_target}")
    
    # Multiple experiments
    print("\n--- Multiple Experiments ---")
    experiment(N=20, dim=2, num_trials=10)
    experiment(N=100, dim=2, num_trials=10)
    experiment(N=1000, dim=2, num_trials=5)
